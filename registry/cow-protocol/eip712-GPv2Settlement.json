{
  "$schema": "../../specs/erc7730-v2.schema.json",
  "context": {
    "eip712": {
      "deployments": [
        { "chainId": 1, "address": "0x9008D19f58AAbD9eD0D60971565AA8510560ab41" },
        { "chainId": 10, "address": "0x9008D19f58AAbD9eD0D60971565AA8510560ab41" },
        { "chainId": 8453, "address": "0x9008D19f58AAbD9eD0D60971565AA8510560ab41" },
        { "chainId": 42161, "address": "0x9008D19f58AAbD9eD0D60971565AA8510560ab41" },
        { "chainId": 11155111, "address": "0x9008D19f58AAbD9eD0D60971565AA8510560ab41" }
      ],
      "domain": { "name": "Gnosis Protocol", "version": "v2" }
    }
  },
  "metadata": { "owner": "CoW Protocol", "contractName": "GPv2Settlement", "info": { "url": "https://cow.fi" } },
  "display": {
    "formats": {
      "Order(address sellToken,address buyToken,address receiver,uint256 sellAmount,uint256 buyAmount,uint32 validTo,bytes32 appData,uint256 feeAmount,string kind,bool partiallyFillable,string sellTokenBalance,string buyTokenBalance)": {
        "intent": "Swap order",
        "interpolatedIntent": "Swap at most {sellAmount} plus a fee of at most {feeAmount} for at least {buyAmount} if fully filled, to {receiver}, until {validTo}",
        "fields": [
          { "path": "sellAmount", "label": "Max to sell", "format": "tokenAmount", "params": { "tokenPath": "sellToken" } },
          {
            "path": "buyAmount",
            "label": "Min if fully filled",
            "format": "tokenAmount",
            "params": { "tokenPath": "buyToken", "nativeCurrencyAddress": ["0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE"] }
          },
          { "path": "feeAmount", "label": "Max fee on top", "format": "tokenAmount", "params": { "tokenPath": "sellToken" } },
          {
            "path": "receiver",
            "label": "Recipient",
            "format": "addressName",
            "params": { "senderAddress": ["0x0000000000000000000000000000000000000000"] }
          },
          { "path": "validTo", "label": "Expires", "format": "date", "params": { "encoding": "timestamp" } },
          { "path": "kind", "label": "Order type", "format": "raw" },
          { "path": "partiallyFillable", "label": "Partial fills", "format": "raw" },
          { "path": "appData", "label": "App data", "visible": "never" },
          {
            "path": "sellTokenBalance",
            "label": "Wallet via Balancer",
            "format": "raw",
            "visible": { "ifNotIn": ["erc20", "internal"] }
          },
          {
            "path": "sellTokenBalance",
            "label": "Sell: Balancer Vault",
            "format": "raw",
            "visible": { "ifNotIn": ["erc20", "external"] }
          },
          { "path": "buyTokenBalance", "label": "Buy: Balancer Vault", "format": "raw", "visible": { "ifNotIn": ["erc20"] } }
        ]
      },
      "OrderCancellations(bytes[] orderUids)": { "intent": "Request offchain cancel", "fields": [{ "path": "orderUids.[]", "label": "Order ID", "format": "raw" }] }
    }
  }
}
